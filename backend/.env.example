# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///phone_receptionist.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Run Alembic migrations on startup. With several replicas set false and run
# `python -m db.migrate` once per deploy instead.
AUTO_MIGRATE=true

# Public https origin Twilio reaches, e.g. https://vaani.yourdomain.com.
# Required in production: Twilio signs the exact URL it calls, and behind a
# proxy the app cannot reconstruct it on its own.
PUBLIC_BASE_URL=

# Twilio (phone integration)
TWILIO_ACCOUNT_SID=
# Also used to verify X-Twilio-Signature on every webhook. Without it,
# production rejects all voice webhooks.
TWILIO_AUTH_TOKEN=
# Platform fallback sender for SMS; each client's own number is preferred.
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true
# India: SMS needs a DLT-registered sender and template. Put the Messaging
# Service that carries that registration here (see services/notify.py).
TWILIO_MESSAGING_SERVICE_SID=

# ---------------------------------------------------------------------------
# Speech engines
#
# "auto" = use the best provider that is actually configured, and fall back to
# the browser's built-in speech when none is. A demo therefore works with no
# keys at all; add keys per client without touching code.
#   TTS_PROVIDER: auto | elevenlabs | piper | none
#   STT_PROVIDER: auto | deepgram | faster_whisper | none
# ---------------------------------------------------------------------------
TTS_PROVIDER=auto
STT_PROVIDER=auto

# --- Free / offline engines (no key, no per-minute cost) ---
# Piper TTS: pip install piper-tts, then download a voice .onnx (+ .onnx.json)
# from https://huggingface.co/rhasspy/piper-voices and point at it. If left
# blank, the first .onnx in backend/models/piper/ is used.
PIPER_VOICE=

# faster-whisper STT: pip install faster-whisper
# tiny | base | small | medium | large-v3   (base is the demo sweet spot)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Paid engines (switch these on per client) ---
# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=
# Pre-recorded transcription model for uploaded audio.
DEEPGRAM_MODEL=nova-2

# ElevenLabs (text-to-speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- The model that answers the phone -------------------------------------
# Vaani speaks the OpenAI-compatible chat API, so any host below works and the
# default path uses open weights. LLM_PROVIDER=auto picks the first one you
# gave a key to, in this order: LLM_BASE_URL -> OpenRouter -> Groq -> Together.
# Leave LLM_MODEL blank to use that provider's default model.
#
#   openrouter   OPENROUTER_API_KEY   qwen/qwen3-30b-a3b-instruct-2507
#   groq         GROQ_API_KEY         llama-3.3-70b-versatile
#   together     TOGETHER_API_KEY     Qwen/Qwen2.5-72B-Instruct-Turbo
#   ollama       (no key)             qwen2.5:7b-instruct   [LLM_PROVIDER=ollama]
#   openai       OPENAI_API_KEY       gpt-4o-mini           [closed weights]
#
# With no key at all Vaani still runs: the deterministic booking flow books
# real appointments, and FAQs come from the owner's own answers.
LLM_PROVIDER=auto
LLM_MODEL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
# Any other OpenAI-compatible endpoint (vLLM, LM Studio, Azure, a proxy).
LLM_BASE_URL=
LLM_API_KEY=
# A caller is waiting while this runs, so fail fast into the fallback.
LLM_TIMEOUT_SECONDS=10
OPENAI_API_KEY=

# Security & Auth
# Encrypts call transcripts at rest. Required in production. Losing it loses
# every stored transcript - back it up separately from the database.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8080,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Phone conversation engine
#   gather = <Gather>/<Say> request-response (simple, robust)
#   relay  = Twilio ConversationRelay: streaming speech, barge-in, "one
#            moment" fillers - much lower latency. Needs https PUBLIC_BASE_URL.
# ---------------------------------------------------------------------------
VOICE_MODE=gather
RELAY_TTS_PROVIDER=Google
RELAY_TRANSCRIPTION_PROVIDER=Deepgram

# Self-serve phone numbers (buying spends money on your Twilio account).
SELF_SERVE_NUMBERS=false
TWILIO_NUMBER_COUNTRY=IN
# India: regulatory bundle + address from the Twilio console, required to buy.
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=

# WhatsApp confirmations/reminders (Meta-approved templates via Twilio Content).
TWILIO_WHATSAPP_FROM=
WHATSAPP_CONFIRMATION_CONTENT_SID=
WHATSAPP_REMINDER_CONTENT_SID=

# Email: password resets, verification, owner alerts. Blank = logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Vaani <no-reply@yourdomain.com>
SMTP_STARTTLS=true

# Google Calendar sync (OAuth "Web application" client; redirect URI
# {PUBLIC_BASE_URL}/api/integrations/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sarvam AI - Indian-language TTS for the web demo (preferred when set).
SARVAM_API_KEY=
SARVAM_SPEAKER=priya
SARVAM_MODEL=bulbul:v3

# Backup LLM when OpenAI fails: any OpenAI-compatible endpoint.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Minutes: alert owners at 80%/100% of their allowance; with this on, calls
# over the allowance get a short message and a logged callback instead.
HARD_MINUTE_CAP=false
# Scrub transcripts after N days for businesses without their own setting (0 = keep).
DEFAULT_RETENTION_DAYS=0

# Operations
REDIS_URL=
SENTRY_DSN=
LOG_FORMAT=text
DOCS_ENABLED=

# Filled into the [PLACEHOLDERS] of /legal - have a lawyer review the text.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_CITY=
LEGAL_JURISDICTION=
PRIVACY_EMAIL=
SUPPORT_EMAIL=
CLOUD_HOST=
RETENTION_PERIOD_TEXT=
