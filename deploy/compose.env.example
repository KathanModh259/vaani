# Settings docker compose reads for interpolation (POSTGRES_PASSWORD,
# JWT_SECRET_KEY, ENCRYPTION_KEY, PUBLIC_BASE_URL, DOMAIN).
#
#   cp deploy/compose.env.example .env
#   python -m scripts.init_env --write      # fills the secrets in both files
#   docker compose up -d --build
#
# This file lives at the repo root, next to docker-compose.yml, because that
# is where compose looks automatically - so `docker compose logs`, `exec` and
# `ps` work without exporting anything in your shell.
#
# It is git-ignored. Never commit it.

# --- the domain users and Twilio reach -------------------------------------
# The public origin. Twilio signs the exact URL it calls, so this must be the
# real https origin with no trailing slash.
PUBLIC_BASE_URL=https://vaani.example.com
# What Caddy serves. A real domain gets automatic Let's Encrypt HTTPS; use
# ":80" for a local stack test with no certificate.
DOMAIN=vaani.example.com
# Who may call the API cross-origin. Same-origin pages do not need it; add
# other origins you control.
CORS_ORIGINS=https://vaani.example.com

# --- secrets: generate these, do not invent them ---------------------------
# python -m scripts.init_env --write fills all three and keeps them in sync
# with backend/.env.
POSTGRES_PASSWORD=
# Signs session tokens. Rotating it logs everyone out.
JWT_SECRET_KEY=
# Encrypts call transcripts at rest. Losing it loses every transcript, so back
# it up separately from the database.
ENCRYPTION_KEY=

# --- optional --------------------------------------------------------------
# 1 bakes the free Piper/faster-whisper engines into the image (+~175MB).
WITH_SPEECH=0
# Nightly pg_dump retention, in ./backups.
BACKUP_KEEP_DAYS=14
# One replica runs migrations at boot. With several, set false and run
# `docker compose exec api python -m db.migrate` once per deploy.
AUTO_MIGRATE=true